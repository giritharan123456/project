# Frontend
# Use "/api" for production when the frontend and API are served by the same Vercel app.
VITE_API_URL=/api
VITE_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Backend
MONGODB_URI=mongodb://localhost:27017/marketvision
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional
LOG_LEVEL=info

# Vercel (auto-set by Vercel platform)
# VERCEL=1
